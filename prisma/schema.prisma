// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id               Int      @id @default(autoincrement())
  productName      String   @unique
  avgDailyDemand   Float
  itemRmse         Float
  safetyStock      Float
  reorderPoint     Float
  currentStock     Int      // We will generate a starting stock during the seed upload

  transactions     InventoryTransaction[]
}

model InventoryTransaction {
  id              Int      @id @default(autoincrement())
  productName     String
  quantityChange  Int      // Negative for sales, Positive for restocks
  transactionType String   // "SALE" or "RESTOCK"
  createdAt       DateTime @default(now())

  item            Item     @relation(fields: [productName], references: [productName])
}